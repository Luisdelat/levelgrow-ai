# ==========================================
# LEVELGROW AI - Environment Variables
# ==========================================

# PayPal Configuration
# Get from: https://developer.paypal.com/dashboard/
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-client-id
PAYPAL_SECRET=your-secret

# Database (PostgreSQL via Supabase)
# 1. Create project at https://supabase.com
# 2. Copy the connection string from Settings > Database
DATABASE_URL=postgresql://user:password@host:5432/levelgrow

# Supabase Configuration (Optional - only if using Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Claude API
# Get from: https://console.anthropic.com
NEXT_PUBLIC_CLAUDE_API_KEY=sk-ant-your-key-here

# App Configuration
NEXT_PUBLIC_APP_URL=https://app.levelgrowai.com
NODE_ENV=production

# Vercel Deployment
# These are set automatically by Vercel, no need to configure
# VERCEL_URL
# VERCEL_ENV
